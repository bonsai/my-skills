{
  "$schema": "https://opencode.ai/config.json",
  "model": "sakura/preview/Kimi-K2.7-Code",
  "disabled_providers": [
    "anthropic",
    "google",
    "groq",
    "mistral",
    "together",
    "cohere",
    "perplexity",
    "deepseek"
  ],
  "default_agent": "kimura",
  "skills": {
    "paths": [
      "~/room/skills"
    ]
  },
  "provider": {
    "opencode-go": {
      "api": "https://opencode.ai/api/v1",
      "name": "OpenCode Go (Subscription)",
      "options": {
        "baseURL": "https://opencode.ai/api/v1",
        "apiKey": "${OPENCODE_API_KEY}"
      }
    },
    "deepseek": {
      "api": "https://api.deepseek.com/v1",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "${DEEPSEEK_API_KEY}"
      }
    },
    "openrouter": {
      "api": "https://openrouter.ai/api/v1",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      }
    },
    "sakura": {
      "api": "https://api.ai.sakura.ad.jp/v1",
      "name": "Sakura AI Engine",
      "options": {
        "baseURL": "https://api.ai.sakura.ad.jp/v1",
        "apiKey": "${SAKURA_API_KEY}"
      }
    }
  },
  "mcp": {
    "music-engine": {
      "type": "local",
      "enabled": false,
      "command": "python",
      "args": [
        "/mnt/c/Users/dance/Documents/MEGA/music-engine/server_mcp.py"
      ]
    },
    "mito-chan": {
      "type": "local",
      "enabled": true,
      "command": "mito-mcp"
    },
    "shizuka-mcp": {
      "type": "url",
      "enabled": true,
      "url": "https://shizuka-mcp-3t4nrcmxvq-an.a.run.app/sse"
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "render-mcp": {
      "command": "/home/sexy/go/bin/render-mcp-server",
      "type": "local",
      "enabled": true
    },
    "tmux-mcp": {
      "type": "local",
      "enabled": true,
      "command": "python",
      "args": [
        "/home/sexy/mcp/tmux-mcp/server.py"
      ]
    },
    "model-manager": {
      "type": "local",
      "enabled": true,
      "command": "/home/sexy/wiki/skill/hermes-agent/model-manager/model-manager-linux",
      "args": [
        "--mcp"
      ]
    },
    "hermes": {
      "type": "local",
      "enabled": true,
      "command": "/home/sexy/.hermes/venv/bin/python",
      "args": [
        "/home/sexy/wiki/agent/hermes/mcp_serve.py"
      ]
    }
  }
}